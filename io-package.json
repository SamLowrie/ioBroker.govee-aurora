{
  "common": {
    "name": "govee-aurora",
    "version": "0.3.0",
    "title": "Govee Aurora",
    "titleLang": {
      "en": "Govee Aurora"
    },
    "desc": {
      "en": "Control one Govee Aurora H6093 projector directly over UDP without cloud access or discovery"
    },
    "authors": [
      "Magnus"
    ],
    "author": "Magnus",
    "keywords": [
      "govee",
      "H6093",
      "projector",
      "local",
      "UDP"
    ],
    "licenseInformation": {
      "type": "free",
      "license": "MIT"
    },
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "icon": "govee-aurora.svg",
    "enabled": true,
    "loglevel": "info",
    "mode": "daemon",
    "type": "lighting",
    "tier": 2,
    "compact": true,
    "connectionType": "local",
    "dataSource": "assumption",
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ]
  },
  "native": {
    "ip": "",
    "port": 4003
  },
